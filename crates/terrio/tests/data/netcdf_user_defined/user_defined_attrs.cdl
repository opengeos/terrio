// A NetCDF-4 grid whose attributes use user-defined types: compounds (one with a 2-D array
// field), an enum and an int vlen.
// Regenerate with `ncgen -4 -o user_defined_attrs.nc user_defined_attrs.cdl`.
netcdf user_defined_attrs {
types:
  compound station_t {
    int id ;
    double elevation ;
  } ;
  compound grid_t {
    int vals(2, 3) ;
  } ;
  byte enum flag_t {clear = 0, cloud = 1} ;
  int(*) ivlen_t ;
dimensions:
  y = 2 ;
  x = 3 ;
variables:
  float z(y, x) ;
    z:units = "m" ;
    station_t z:station = {7, 12.5} ;
    flag_t z:flag = cloud ;
    ivlen_t z:counts = {1, 2, 3} ;
    grid_t z:grid = {{1, 2, 3, 4, 5, 6}} ;
// global attributes:
    :title = "user-defined attributes" ;
    station_t :origin = {1, -3.25} ;
data:
  z = 1, 2, 3, 4, 5, 6 ;
}
